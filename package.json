{
  "name": "duora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @duora/web dev",
    "build": "pnpm --filter @duora/web build",
    "lint": "pnpm --filter @duora/web lint",
    "test": "pnpm --filter @duora/web test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @duora/db generate",
    "db:migrate": "pnpm --filter @duora/db migrate"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
